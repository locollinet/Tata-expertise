# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Configuration VP Expertise
PORT=3000
NODE_ENV=development
DB_PATH=./data/vp_expertise.db
UPLOADS_DIR=./data/uploads

# Billing thresholds & default rates
BILLING_THRESHOLD_REMINDER=3500
DEFAULT_HOURLY_RATE=190
TRAVEL_HOURLY_RATE=135
KILOMETER_RATE=0.95
VAT_RATE=0.20
